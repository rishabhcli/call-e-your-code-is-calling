{
  "name": "call-e-your-code-is-calling",
  "version": "0.0.0",
  "private": true,
  "description": "Evidence-backed phone verification for time-sensitive emergency resource directories.",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "build": "pnpm run build:packages && pnpm --filter @call-e-directory/operator build",
    "build:packages": "pnpm --filter './packages/**' --workspace-concurrency=1 run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm boundary:check && pnpm dependency:check && pnpm security:audit",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "pnpm build:packages && eslint . --max-warnings 0",
    "typecheck": "pnpm build:packages && pnpm --recursive --if-present run typecheck && tsc --project tsconfig.tests.json --noEmit",
    "boundary:check": "depcruise --config dependency-cruiser.config.mjs packages apps/operator/src tests scripts",
    "dependency:check": "node scripts/check-dependency-register.mjs",
    "security:audit": "pnpm audit --audit-level high",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:integration": "vitest run --config vitest.config.ts --project integration",
    "test:e2e": "node scripts/playwright-cli.mjs test",
    "playwright:install": "node scripts/playwright-cli.mjs install chromium",
    "verify-all": "node scripts/verify-all.mjs",
    "full-verify": "pnpm verify-all",
    "verify:clean-checkout": "node scripts/verify-clean-checkout.mjs",
    "dev:preflight": "node scripts/dev-lifecycle.mjs preflight",
    "dev:up": "node scripts/dev-lifecycle.mjs up",
    "dev:down": "node scripts/dev-lifecycle.mjs down",
    "dev:health": "node scripts/dev-lifecycle.mjs health"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "dependency-cruiser": "18.1.1",
    "eslint": "10.8.1",
    "fast-check": "4.9.0",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
